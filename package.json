{
  "name": "discord-llm",
  "version": "0.1.0",
  "description": "Discord bot for chatting with local LLMs (OpenAI-compatible), with per-thread sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find test -name '*.test.ts')",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "14.27.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.0",
    "prettier": "3.4.2",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
